# ========================================================
# OS-Agent Environment Configuration
# ========================================================

# GitHub Personal Access Token (Requires `repo`, `read:org`, `write:discussion` scopes)
GITHUB_TOKEN=ghp_your_github_token_here

# Your GitHub Username (Used to push to your forks)
GITHUB_USERNAME=your_github_username

# Google Gemini API Key (Used for codebase analysis & code fix generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Grok / xAI API Key (Used for humanized PR reviews, mentor comments & issue claims)
# Grok endpoint defaults to https://api.x.ai/v1
GROK_API_KEY=your_grok_xai_api_key_here
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# Time Window Configuration (24-hour format HH:MM)
# Example: Active daily from 12:00 to 14:00 (12 PM to 2 PM)
WORK_WINDOW_START=12:00
WORK_WINDOW_END=14:00
TIMEZONE=Asia/Kolkata

# Execution Safety & Human-in-the-Loop Mode
# Options:
#   DRY_RUN=true    -> Analyzes issues and writes code locally without touching remote GitHub
#   REQUIRE_APPROVAL=true -> Prompts user in Dashboard/CLI before pushing commits or creating PRs
DRY_RUN=false
REQUIRE_APPROVAL=true

# Workspace directory for cloning repositories
WORKSPACES_DIR=./cloned_repos
